# Supabase Cloud Production Configuration
# Copy to .env.local and fill in your actual values from Supabase Dashboard > Settings > API

# Supabase Cloud (replace with your project values)
NEXT_PUBLIC_SUPABASE_URL=https://qknqurlwkobgzgfkbbgq.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# App
NEXT_PUBLIC_APP_URL=https://inba-platform.vercel.app
NEXT_PUBLIC_APP_NAME="INBA Ecuador"

# Email (Resend - production)
RESEND_API_KEY=re_your_production_key
EMAIL_FROM="INBA Ecuador <noreply@inbaecuador.org>"

# Video (Mux - optional)
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
MUX_WEBHOOK_SECRET=

# QR Code
QR_CODE_BASE_URL=https://inba-platform.vercel.app/verificar-certificado

# App Config
NODE_ENV=production